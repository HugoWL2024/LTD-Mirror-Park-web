# Supabase env example
# Set these in your server environment (do NOT commit secrets)
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For local psql migrations (optional)
# PG_CONNECTION=postgresql://<db_user>:<db_pass>@db.<project_ref>.supabase.co:5432/postgres